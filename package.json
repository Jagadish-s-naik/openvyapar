{
  "name": "openvyapar",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenVyapar Unified Business Identity — Reimagined DPI for Business Owners",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm --workspace=shared run build && npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "node shared/test-shared.mjs && npm --workspace=backend run test",
    "test:demo": "node demo/run-demo-flow.mjs",
    "seed": "node demo/seed-demo.js",
    "db:migrate": "npm --workspace=backend run db:migrate",
    "db:seed": "npm --workspace=backend run seed",
    "start:backend": "npm --workspace=backend start",
    "start:frontend": "npm --workspace=frontend dev",
    "start:wallet": "npm --workspace=frontend dev",
    "start:verifier": "npm --workspace=frontend dev",
    "start:onboarding": "npm --workspace=frontend dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec backend node backend/dist/src/db/seed.js"
  },
  "keywords": [
    "dpi",
    "business-identity",
    "openvyapar",
    "verifiable-credentials",
    "india"
  ],
  "author": "OpenVyapar Team",
  "license": "MIT"
}
