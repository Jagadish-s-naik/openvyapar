{
  "name": "openvyapar",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenVyapar Unified Business Identity — Reimagined DPI for Business Owners",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend-wallet",
    "frontend-verifier",
    "frontend-onboarding"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm --workspace=shared run build && npm --workspace=backend run build && npm --workspace=frontend-wallet run build",
    "test": "node shared/test-shared.mjs && npm --workspace=backend run test",
    "test:demo": "node demo/run-demo-flow.mjs",
    "seed": "node demo/seed-demo.js",
    "start:backend": "npm --workspace=backend start",
    "start:wallet": "npm --workspace=frontend-wallet start",
    "start:verifier": "npm --workspace=frontend-verifier start",
    "start:onboarding": "npm --workspace=frontend-onboarding start"
  },
  "keywords": [
    "dpi",
    "business-identity",
    "openvyapar",
    "verifiable-credentials",
    "india"
  ],
  "author": "OpenVyapar Team",
  "license": "MIT"
}
