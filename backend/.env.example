# ==========================================
# OpenVyapar Backend Environment Variables
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins (supports wildcards like https://*.vercel.app or *)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# MongoDB Configuration
ENABLE_MONGODB=true
MONGODB_URI=mongodb://127.0.0.1:27017/openvyapar
MONGODB_DB_NAME=openvyapar
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000

# Cryptographic & Security Keys
CRYPTO_SIGNING_SECRET=openvyapar_dev_secret_key_change_in_production_2026

# AI Engine Credentials (Optional - Falls back to Deterministic Mock)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
